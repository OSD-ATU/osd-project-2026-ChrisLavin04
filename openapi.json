  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId"
          },
          "user_id": {
            "type": "string",
            "pattern": "^U\\d{3,}$",
            "example": "U001"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "example": "coach_john"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "password_hash": {
            "type": "string",
            "example": "$2b$10$abcdefghijklmnopqrstuv"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "coach", "player", "manager"],
            "example": "coach"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["username", "email", "password_hash", "role"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9_]+$",
            "example": "coach_john"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "example": "john.doe@example.com"
          },
          "password_hash": {
            "type": "string",
            "minLength": 1,
            "example": "$2b$10$abcdefghijklmnopqrstuv"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "coach", "player", "manager"],
            "example": "coach"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100
          },
          "password_hash": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["admin", "coach", "player", "manager"]
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId"
          },
          "player_id": {
            "type": "string",
            "pattern": "^P\\d{3,}$",
            "example": "P001"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Lionel Messi"
          },
          "position": {
            "type": "string",
            "enum": ["Goalkeeper", "Defender", "Midfielder", "Forward"],
            "example": "Forward"
          },
          "age": {
            "type": "integer",
            "minimum": 16,
            "maximum": 45,
            "example": 36
          },
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          }
        }
      },
      "CreatePlayerRequest": {
        "type": "object",
        "required": ["player_id", "name", "position", "age"],
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^P\\d{3,}$",
            "example": "P001"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z\\s''-]+$",
            "example": "Lionel Messi"
          },
          "position": {
            "type": "string",
            "enum": ["Goalkeeper", "Defender", "Midfielder", "Forward"],
            "example": "Forward"
          },
          "age": {
            "type": "integer",
            "minimum": 16,
            "maximum": 45,
            "example": 36
          },
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          }
        }
      },
      "UpdatePlayerRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^P\\d{3,}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z\\s''-]+$"
          },
          "position": {
            "type": "string",
            "enum": ["Goalkeeper", "Defender", "Midfielder", "Forward"]
          },
          "age": {
            "type": "integer",
            "minimum": 16,
            "maximum": 45
          },
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$"
          }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId"
          },
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Manchester United"
          },
          "coach": {
            "type": "string",
            "pattern": "^U\\d{3,}$",
            "example": "U001"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P\\d{3,}$"
            },
            "maxItems": 25,
            "example": ["P001", "P002", "P003"]
          }
        }
      },
      "CreateTeamRequest": {
        "type": "object",
        "required": ["team_id", "name", "coach"],
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9\\s''-]+$",
            "example": "Manchester United"
          },
          "coach": {
            "type": "string",
            "pattern": "^U\\d{3,}$",
            "example": "U001"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P\\d{3,}$"
            },
            "maxItems": 25,
            "example": ["P001", "P002", "P003"]
          }
        }
      },
      "UpdateTeamRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9\\s''-]+$"
          },
          "coach": {
            "type": "string",
            "pattern": "^U\\d{3,}$"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P\\d{3,}$"
            },
            "maxItems": 25
          }
        }
      },
      "Match": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId"
          },
          "match_id": {
            "type": "string",
            "pattern": "^M\\d{3,}$",
            "example": "M001"
          },
          "home_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          },
          "away_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T002"
          },
          "score": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "object",
                "properties": {
                  "home": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "away": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ],
            "example": {
              "home": 2,
              "away": 1
            }
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2024-12-01T15:00:00Z"
          }
        }
      },
      "CreateMatchRequest": {
        "type": "object",
        "required": ["match_id", "home_team_id", "away_team_id", "date"],
        "properties": {
          "match_id": {
            "type": "string",
            "pattern": "^M\\d{3,}$",
            "example": "M001"
          },
          "home_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T001"
          },
          "away_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$",
            "example": "T002"
          },
          "score": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "object",
                "properties": {
                  "home": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "away": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ],
            "default": {
              "home": 0,
              "away": 0
            }
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2024-12-01T15:00:00Z"
          }
        }
      },
      "UpdateMatchRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "match_id": {
            "type": "string",
            "pattern": "^M\\d{3,}$"
          },
          "home_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$"
          },
          "away_team_id": {
            "type": "string",
            "pattern": "^T\\d{3,}$"
          },
          "score": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
